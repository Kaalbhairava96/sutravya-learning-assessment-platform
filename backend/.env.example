# Copy this file to .env and replace placeholders for your local setup.
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/sutravya_assessment
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# Leave blank for ordinary startup. OTP digest operations fail closed without a strong secret.
OTP_HMAC_PEPPER=
# Set these only in the backend's private environment after a Resend sending domain is verified.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Exact website origins allowed to call the API; use comma-separated origins, no paths.
CORS_ORIGINS=
